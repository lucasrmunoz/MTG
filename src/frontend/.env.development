# Loaded by `next dev` only, never by `next build`.
#
# Points the dev server at the local Mtg.Api so all three price vendors are available. Production
# builds deliberately leave this unset, which makes the app talk to Scryfall directly — the only
# thing that works on a static host like GitHub Pages.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# The local Mtg.Api also relays shared game sessions; unset, every sharing affordance hides.
NEXT_PUBLIC_SESSION_WS_URL=ws://localhost:5000/api/sessions/ws

# Where QR join links point. In dev that is this dev server; for phones on the same wifi,
# override both URLs with the PC's LAN IP (see docs/HOW-TO-RUN.md).
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000

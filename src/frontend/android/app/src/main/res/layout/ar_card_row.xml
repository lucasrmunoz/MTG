<?xml version="1.0" encoding="utf-8"?>
<!-- One card in the openable AR card list: scan thumbnail, name, details, tracking status. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/ar_row_thumb"
        android:layout_width="40dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ar_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ar_foreground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ar_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ar_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ar_row_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/ar_orange"
        android:textSize="12sp" />

    <Button
        android:id="@+id/ar_row_replace"
        style="@style/ArSmallPillButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/ar_row_replace" />

    <Button
        android:id="@+id/ar_row_remove"
        style="@style/ArSmallPillButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/ar_row_remove" />
</LinearLayout>

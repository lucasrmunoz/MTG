<?xml version="1.0" encoding="utf-8"?>
<!-- The AR chrome's standard button: a translucent surface pill with a purple border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/ar_pill_fill" />
    <stroke android:width="1dp" android:color="@color/ar_purple_border" />
    <corners android:radius="20dp" />
</shape>
